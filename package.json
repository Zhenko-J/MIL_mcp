{
  "name": "milanote-mcp",
  "version": "0.10.0",
  "private": true,
  "description": "Serveur MCP local (stdio) non officiel pour lire et écrire dans Milanote via l'API interne du client web.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "milanote-mcp": "dist/src/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "session": "node scripts/session.mjs",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.65.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zhenko-J/milanote-mcp.git"
  }
}
